# 1. Validar cantidad de estudiantes (entre 5 y 20)
n = int(input("Ingrese la cantidad de estudiantes (5 a 20): "))
while n < 5 or n > 20:
    print("Error: La cantidad debe estar entre 5 y 20.")
    n = int(input("Ingrese nuevamente la cantidad de estudiantes: "))

# 2. Leer y validar las notas (entre 0 y 20)
notas = []
for i in range(n):
    nota = int(input(f"Ingrese la nota del estudiante {i + 1} (0 a 20): "))
    while nota < 0 or nota > 20:
        print("Error: La nota debe estar entre 0 y 20.")
        nota = int(input(f"Ingrese nuevamente la nota del estudiante {i + 1}: "))
    notas.append(nota)

# 3. Cálculos principales
mayor_nota = max(notas)
menor_nota = min(notas)
cant_mayor = notas.count(mayor_nota)
cant_menor = notas.count(menor_nota)
promedio = sum(notas) / n

pares = 0
impares = 0
aprobados = 0
desaprobados = 0

for nota in notas:
    if nota % 2 == 0:
        pares += 1
    else:
        impares += 1

    if nota >= 13:
        aprobados += 1
    else:
        desaprobados += 1

porc_aprobados = (aprobados / n) * 100
porc_desaprobados = (desaprobados / n) * 100

# 4. Mostrar resultados
print("\n--- RESULTADOS DEL SALÓN ---")
print(f"a) Mayor nota: {mayor_nota}")
print(f"b) Menor nota: {menor_nota}")
print(f"c) Alumnos con la mayor nota: {cant_mayor}")
print(f"d) Alumnos con la menor nota: {cant_menor}")
print(f"e) Promedio del salón: {promedio:.2f}")
print(f"f) Cantidad de notas pares: {pares}")
print(f"g) Cantidad de notas impares: {impares}")
print(f"h) Alumnos aprobados: {aprobados}")
print(f"i) Alumnos desaprobados: {desaprobados}")
print(f"j) Porcentaje de aprobados: {porc_aprobados:.2f}%")
print(f"k) Porcentaje de desaprobados: {porc_desaprobados:.2f}%")