#EJERCICIO 02
#Realizar un algoritmo que permita pedir 10 números y determine e 
# imprima cuantos son pares, impares, positivos, neutros y negativos.

# DECLARACIÓN DE VARIABLES
numero: float = 0.0
pares: int = 0
impares: int = 0
positivos: int = 0
neutros: int = 0
negativos: int = 0

# PROCESO
for i in range(1, 11):
    numero = float(input("Ingrese un número: "))
    if numero % 2 == 0:
        pares += 1
    else:
        impares += 1
    if numero > 0:
        positivos += 1
    elif numero == 0:
        neutros += 1
    else:
        negativos += 1

# SALIDA DE DATOS
print(f'Cantidad de pares: {pares}')
print(f'Cantidad de impares: {impares}')
print(f'Cantidad de positivos: {positivos}')
print(f'Cantidad de neutros: {neutros}')
print(f'Cantidad de negativos: {negativos}')