# --- FUNCIONES (Retornan un valor) ---
def pedir_deposito(numero_mes):
  """Pide al usuario el monto a depositar en un mes específico y 
  valida que no sea negativo."""
  while True:
    try:
      monto = float(
          input(f"Ingrese la cantidad a depositar en el mes {numero_mes}: S/ ")
      )
      if monto < 0:
        print("Error: El monto no puede ser negativo. Intente de nuevo.")
      else:
        return monto
    except ValueError:
      print("Error: Por favor, ingrese un número válido.")


def calcular_ahorro_total(lista_depositos):
  """Recibe el array de depósitos y devuelve la suma total ahorrada."""
  total = 0.0
  for deposito in lista_depositos:
    total += deposito
  return total


# --- PROCEDIMIENTOS (Realizan una acción, no retornan valor) ---
def mostrar_estado_mensual(mes, deposito_actual, acumulado):
  """Muestra cuánto se depositó y cuánto se lleva ahorrado hasta ese mes."""
  print(
      f"--> Mes {mes}: Depositaste S/ {deposito_actual:.2f} | Ahorro acumulado:"
      f" S/ {acumulado:.2f}\n"
  )


def mostrar_resumen_final(lista_depositos, ahorro_final):
  """Muestra el desglose de todos los meses y el ahorro final del año."""
  print("=" * 50)
  print("RESUMEN ANUAL DE AHORROS")
  print("=" * 50)

  # Recorremos el array para mostrar cada mes
  for i in range(len(lista_depositos)):
    print(f"Mes {i + 1:02d}: S/ {lista_depositos[i]:.2f}")

  print("-" * 50)
  print(f"AHORRO FINAL DESPUÉS DE 12 MESES: S/ {ahorro_final:.2f}")
  print("=" * 50)


# --- PROGRAMA PRINCIPAL ---
def main():
  # Declaración del array (lista en Python) para guardar los 12 depósitos
  depositos_anuales = []
  ahorro_acumulado = 0.0
  MESES_DEL_ANIO = 12

  print("=== SISTEMA DE CONTROL DE AHORRO ANUAL ===\n")

  # Estructura repetitiva (ciclo for) para los 12 meses
  for mes in range(1, MESES_DEL_ANIO + 1):
    # 1. Llamada a función para obtener el dato
    deposito = pedir_deposito(mes)

    # 2. Guardar en el array
    depositos_anuales.append(deposito)

    # 3. Actualizar el acumulado y llamar al procedimiento para mostrarlo
    ahorro_acumulado += deposito
    mostrar_estado_mensual(mes, deposito, ahorro_acumulado)

  # 4. Llamada a función para calcular el total final desde el array
  total_final = calcular_ahorro_total(depositos_anuales)

  # 5. Llamada a procedimiento para imprimir el reporte final
  mostrar_resumen_final(depositos_anuales, total_final)


# Punto de entrada del programa
if __name__ == "__main__":
  main()